datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum TemplateType {
  GREEN_SCREEN
  SLIDESHOW
  WALL_OF_TEXT
  HOOK_DEMO
}

enum CardStatus {
  UNVIEWED
  DISMISSED
  LIBRARY_SAVED
  SCHEDULED
  RENDERING
  RENDERED
  PUBLISHED
  FAILED
}

enum SocialPlatform {
  TIKTOK
  INSTAGRAM
  YOUTUBE
  LINKEDIN
}

model User {
  id               String       @id @default(cuid())
  email            String       @unique
  name             String?
  avatarUrl        String?
  creditsBalance   Int          @default(50)
  createdAt        DateTime     @default(now())
  workspaces       Workspace[]
}

model Workspace {
  id             String          @id @default(cuid())
  name           String
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandProfiles  BrandProfile[]
  blitzCards     BlitzCard[]
  socialAccounts SocialAccount[]
  createdAt      DateTime        @default(now())
}

model BrandProfile {
  id              String          @id @default(cuid())
  workspaceId     String
  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  websiteUrl      String
  companyName     String
  tagline         String?
  targetAudience  String
  brandVoice      String
  corePainPoints  String[]
  keyBenefits     String[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  blitzCards      BlitzCard[]
}

model MemeTemplate {
  id                  String          @id @default(cuid())
  slug                String          @unique
  creatorHandle       String
  originalLikes       String
  originalViews       String
  originalHookText    String
  originalVideoUrl    String

  templateType        TemplateType    @default(GREEN_SCREEN)
  foregroundCutoutUrl String
  defaultBrollUrl     String
  audioTrackUrl       String
  hookSyntaxFormula   String

  blitzCards          BlitzCard[]
  createdAt           DateTime        @default(now())
}

model BlitzCard {
  id                String          @id @default(cuid())
  workspaceId       String
  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brandProfileId    String
  brandProfile      BrandProfile    @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  memeTemplateId    String?
  memeTemplate      MemeTemplate?   @relation(fields: [memeTemplateId], references: [id])

  templateType      TemplateType    @default(GREEN_SCREEN)
  positioningAngle  String
  whyThisContent    String

  // Parody Script & Overlay Copy
  hookText          String
  mentionBusiness   Boolean         @default(true)
  slidesContent     Json?

  // Media Composition Manifest
  foregroundVideoUrl String
  backgroundAssetUrl String
  audioTrackUrl      String
  zoomPercent        Int            @default(102)
  posX               Float          @default(0)
  posY               Float          @default(0)

  // State Machine & Scheduling
  status            CardStatus      @default(UNVIEWED)
  swipedAt          DateTime?
  scheduledFor      DateTime?
  publishedAt       DateTime?
  targetPlatforms   SocialPlatform[] @default([TIKTOK, INSTAGRAM, YOUTUBE])
  renderedMp4Url    String?
  renderError       String?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model SocialAccount {
  id           String         @id @default(cuid())
  workspaceId  String
  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  platform     SocialPlatform
  accountName  String
  accessToken  String
  refreshToken String?
  tokenExpiry  DateTime?
  externalId   String
  createdAt    DateTime       @default(now())
}
