datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

// Emulate enums as strings in SQLite (Prisma will map these natively for PostgreSQL but for dev.db sqlite it creates String types, which is fine for sandbox).
// To enforce type-safety, we will just keep them as Enums but use SQLite provider.
// Actually Prisma SQLite doesn't support enums natively. We'll use String type with default values.

model User {
  id               String       @id @default(cuid())
  email            String       @unique
  name             String?
  avatarUrl        String?
  creditsBalance   Int          @default(50)
  createdAt        DateTime     @default(now())
  workspaces       Workspace[]
}

model Workspace {
  id             String          @id @default(cuid())
  name           String
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandProfiles  BrandProfile[]
  blitzCards     BlitzCard[]
  socialAccounts SocialAccount[]
  createdAt      DateTime        @default(now())
}

model BrandProfile {
  id              String          @id @default(cuid())
  workspaceId     String
  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  websiteUrl      String
  companyName     String
  tagline         String?
  targetAudience  String
  brandVoice      String

  // Storing arrays as JSON for SQLite compatibility
  corePainPoints  String
  keyBenefits     String

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  blitzCards      BlitzCard[]
}

model MemeTemplate {
  id                  String          @id @default(cuid())
  slug                String          @unique
  creatorHandle       String
  originalLikes       String
  originalViews       String
  originalHookText    String
  originalVideoUrl    String

  templateType        String          @default("GREEN_SCREEN") // GREEN_SCREEN, SLIDESHOW, WALL_OF_TEXT, HOOK_DEMO
  foregroundCutoutUrl String
  defaultBrollUrl     String
  audioTrackUrl       String
  hookSyntaxFormula   String

  blitzCards          BlitzCard[]
  createdAt           DateTime        @default(now())
}

model BlitzCard {
  id                String          @id @default(cuid())
  workspaceId       String
  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brandProfileId    String
  brandProfile      BrandProfile    @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  memeTemplateId    String?
  memeTemplate      MemeTemplate?   @relation(fields: [memeTemplateId], references: [id])

  templateType      String          @default("GREEN_SCREEN")
  positioningAngle  String
  whyThisContent    String

  // Parody Script & Overlay Copy
  hookText          String
  mentionBusiness   Boolean         @default(true)
  slidesContent     String?         // Stored as JSON string

  // Media Composition Manifest
  foregroundVideoUrl String
  backgroundAssetUrl String
  audioTrackUrl      String
  zoomPercent        Int            @default(102)
  posX               Float          @default(0)
  posY               Float          @default(0)

  // State Machine & Scheduling
  status            String          @default("UNVIEWED") // UNVIEWED, DISMISSED, LIBRARY_SAVED, SCHEDULED, RENDERING, RENDERED, PUBLISHED, FAILED
  swipedAt          DateTime?
  scheduledFor      DateTime?
  publishedAt       DateTime?
  targetPlatforms   String          @default("TIKTOK,INSTAGRAM,YOUTUBE") // CSV
  renderedMp4Url    String?
  renderError       String?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model SocialAccount {
  id           String         @id @default(cuid())
  workspaceId  String
  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  platform     String
  accountName  String
  accessToken  String
  refreshToken String?
  tokenExpiry  DateTime?
  externalId   String         @default("unknown")
  createdAt    DateTime       @default(now())
}
